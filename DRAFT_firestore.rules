rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global common primitives and security indicators
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Include the User email from runtime as admin
    function isAdmin() {
      return isEmailVerified() && (
        request.auth.token.email == "SAMEERK0723@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Exact validators for incoming writes
    function isValidTruck(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.category is string && (data.category == "Box Truck" || data.category == "Flatbed" || data.category == "Dump Truck" || data.category == "Reefer" || data.category == "Utility" || data.category == "Cab & Chassis") &&
             data.condition is string && (data.condition == "New" || data.condition == "Pre-Owned") &&
             data.year is int && data.year >= 1900 && data.year <= 2100 &&
             data.make is string && data.make.size() <= 100 &&
             data.model is string && data.model.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             data.imageUrl is string && data.imageUrl.size() <= 10000;
    }

    function isValidPart(data) {
      return data.sku is string && data.sku.size() > 0 && data.sku.size() <= 100 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.category is string && (data.category == "Engine & Drivetrain" || data.category == "Braking System" || data.category == "Hydraulics" || data.category == "Electrical" || data.category == "Filters & Fluids") &&
             data.price is number && data.price >= 0 &&
             data.brand is string && data.brand.size() <= 100 &&
             data.stock is int && data.stock >= 0;
    }

    function isValidTestimonial(data) {
      return data.clientName is string && data.clientName.size() > 0 && data.clientName.size() <= 100 &&
             data.review is string && data.review.size() > 0 && data.review.size() <= 2000 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5;
    }

    function isValidOrder(data) {
      return data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
             data.total is number && data.total >= 0 &&
             data.paymentMethod is string && (data.paymentMethod == "Fleet Card" || data.paymentMethod == "Credit Card" || data.paymentMethod == "Quote Request") &&
             data.status is string && 
             data.date is string;
    }

    function isValidServiceAppointment(data) {
      return data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
             data.vehicleClass is string && (data.vehicleClass == "medium" || data.vehicleClass == "heavy") &&
             data.serviceType is string && (data.serviceType == "pm" || data.serviceType == "repair" || data.serviceType == "body") &&
             data.status is string &&
             data.date is string;
    }

    function isValidLead(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
             data.source is string && (data.source == "Contact Form" || data.source == "Custom Build" || data.source == "Service Estimator" || data.source == "Parts RFQ" || data.source == "Quick Inquiry") &&
             data.status is string &&
             data.date is string;
    }

    function isValidCareerApplicant(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.role is string && data.role.size() > 0 && data.role.size() <= 100 &&
             data.experience is string && data.experience.size() > 0 && data.experience.size() <= 100 &&
             data.pitch is string && data.pitch.size() > 0 && data.pitch.size() <= 5000 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() <= 50 &&
             data.date is string;
    }

    function isValidCustomer(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 150;
    }

    // 4. Resource collection rulesets
    match /trucks/{truckId} {
      allow read: if true;
      allow write: if isAdmin() && isValidTruck(incoming());
    }

    match /parts/{partId} {
      allow read: if true;
      allow write: if isAdmin() && isValidPart(incoming());
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin() || (isSignedIn() && isValidTestimonial(incoming()));
    }

    match /dealerSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /customers/{customerId} {
      allow get: if isSignedIn() && (request.auth.uid == customerId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == customerId && isValidCustomer(incoming());
      allow update: if isSignedIn() && (request.auth.uid == customerId || isAdmin()) && isValidCustomer(incoming());
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.email == request.auth.token.email || isAdmin());
      allow list: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.email == request.auth.token.email || isAdmin());
      allow create: if isSignedIn() && isValidOrder(incoming());
      allow update: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status']));
      allow delete: if isAdmin();
    }

    match /serviceAppointments/{appointmentId} {
      allow get: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.email == request.auth.token.email || isAdmin());
      allow list: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.email == request.auth.token.email || isAdmin());
      allow create: if isSignedIn() && isValidServiceAppointment(incoming());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /leads/{leadId} {
      allow get, list: if isAdmin();
      allow create: if isValidLead(incoming());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /careers/{applicantId} {
      allow get, list: if isAdmin();
      allow create: if isValidCareerApplicant(incoming());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
